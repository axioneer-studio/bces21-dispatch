# Domaines HTTPS configurés dans Coolify pour les services frontend et backend.
FRONTEND_URL=https://dispatch.example.com
API_URL=https://dispatch-api.example.com

# Paramètres du backend (valeurs par défaut indiquées lorsqu'elles sont facultatives).
APP_NAME=BCES Dispatch API
APP_VERSION=0.1.0
DEBUG=false
APP_TIMEZONE=Europe/Paris
# SQLite est stocké dans le volume dispatch-data. Remplacer par une URL
# PostgreSQL async si vous préférez une base de données dédiée.
DATABASE_URL=sqlite+aiosqlite:////app/data/BCES.db
CORS_ALLOW_ORIGINS=https://dispatch.example.com

# Doit correspondre à API_URL/api/auth/discord/callback et être déclaré
# comme Redirect URI dans l'application Discord.
DISCORD_REDIRECT_URI=https://dispatch-api.example.com/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SCOPES=identify

# Générer avec : openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret
SESSION_COOKIE_NAME=bces_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=
SESSION_TTL_SECONDS=1209600

PROFILE_DEADLINE_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=1800
STATUS_SYNC_INTERVAL_SECONDS=30
# Facultatif : personnaliser la source du CSV des statuts.
# STATUS_SHEET_CSV_URL=https://example.com/status.csv

# Paramètres frontend facultatifs
NUXT_PUBLIC_DISCORD_AUTH_URL=/api/auth/discord/start
