# --- API ---
APP_NAME="BCES Dispatch API"
DEBUG=true
# Fuseau d'heures utilisé pour les conversions/affichages côté serveur.
# Exemples : Europe/Paris, America/Montreal, America/Toronto, America/Vancouver, UTC.
# Le front utilise automatiquement la TZ du navigateur pour l'affichage côté utilisateur.
APP_TIMEZONE=Europe/Paris

# --- Base de données ---
DATABASE_URL=sqlite+aiosqlite:///./bces21.db

# --- Frontend (CORS + redirections OAuth) ---
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Discord OAuth2 ---
# Créer une app sur https://discord.com/developers/applications
# Ajouter http://localhost:4200/api/auth/discord/callback aux Redirects
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback
DISCORD_SCOPES=identify

# --- Session ---
SESSION_SECRET=change-me-in-production-use-openssl-rand-hex-32
SESSION_COOKIE_NAME=bces_session
SESSION_TTL_SECONDS=1209600

# --- Profil RP ---
PROFILE_DEADLINE_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=1800